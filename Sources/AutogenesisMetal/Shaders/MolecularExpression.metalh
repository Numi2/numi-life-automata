#pragma once

inline TranscriptRecord emptyTranscriptRecord(uint persistentCellID) {
    TranscriptRecord record;
    record.identity = uint4(invalidGenomePage, 0u, 0u, persistentCellID);
    record.kinetics = float4(0.0);
    return record;
}

inline ProteinRecord emptyProteinRecord() {
    ProteinRecord record;
    record.identity = uint4(invalidGenomePage, 0u, 0u, 0u);
    record.abundance = float4(0.0);
    record.physical = float4(0.0);
    record.activity = float4(0.0);
    record.coupling = float4(0.0);
    return record;
}

inline uint molecularSequenceHash(GenomePage page) {
    uint sequence = hash32(page.header.z ^ (page.header.x * 0x9e3779b9u));
    for (uint index = 0u; index < 6u; ++index) {
        sequence = hash32(
            sequence ^ as_type<uint>(page.payload[index].x) ^
            (as_type<uint>(page.payload[index].y) << 7u) ^
            (as_type<uint>(page.payload[index].z) << 13u) ^
            (as_type<uint>(page.payload[index].w) << 19u)
        );
    }
    return sequence;
}

inline ProteinRecord proteinFromTemplate(
    GenomePage page,
    uint templatePage,
    uint genomeHash,
    float inheritedConcentration
) {
    ProteinRecord protein = emptyProteinRecord();
    uint sequence = molecularSequenceHash(page);
    uint pageType = page.header.x;
    float4 activity = float4(
        random01(sequence + 3u), random01(sequence + 5u),
        random01(sequence + 7u), random01(sequence + 11u)
    ) * 0.24;
    if (pageType == genomePageReaction) { activity.x += 0.76; }
    if (pageType == genomePageTransport) { activity.y += 0.76; }
    if (pageType == genomePageRegulation) { activity.z += 0.76; }
    if (pageType == genomePageMaterial || pageType == genomePageJunction) {
        activity.w += 0.64;
    }
    if (pageType == genomePageNoncoding) { activity *= 0.015; }
    float membraneAffinity = saturate(
        random01(sequence + 17u) * 0.62 +
        (pageType == genomePageTransport || pageType == genomePageReceptor ||
            pageType == genomePageElectrical ? 0.34 : 0.0)
    );
    protein.identity = uint4(
        templatePage, page.header.z, genomeHash,
        min(uint(membraneAffinity * 4.0), 3u)
    );
    protein.abundance = float4(max(inheritedConcentration, 0.0), 0.18, 0.0, 0.0);
    protein.physical = float4(
        0.24 + random01(sequence + 19u) * 0.74,
        signedRandom(sequence + 23u),
        random01(sequence + 29u),
        membraneAffinity
    );
    protein.activity = saturate(activity);
    protein.coupling = saturate(float4(
        random01(sequence + 31u) * 0.34 +
            (pageType == genomePageReceptor ? 0.66 : 0.0),
        random01(sequence + 37u) * 0.30 +
            (pageType == genomePagePlasticity ? 0.58 : 0.0),
        random01(sequence + 41u) * 0.28 +
            (pageType == genomePagePlasticity ? 0.48 : 0.0),
        random01(sequence + 43u) * 0.36 +
            (pageType == genomePageElectrical ? 0.60 : 0.0)
    ));
    return protein;
}

inline uint findMolecularParentIndex(
    device const CellIdentity* identities,
    device const atomic_uint* ownerCellHeads,
    device const uint* ownerCellNext,
    uint owner,
    uint parentPersistentID
) {
    if (owner >= maxAgentCount || parentPersistentID == 0xffffffffu) {
        return maxCellCount;
    }
    uint candidate = atomic_load_explicit(
        &ownerCellHeads[owner], memory_order_relaxed
    );
    uint traversed = 0u;
    while (candidate < maxCellCount && traversed < maxCellCount) {
        if (identities[candidate].persistentID == parentPersistentID) {
            return candidate;
        }
        candidate = ownerCellNext[candidate];
        ++traversed;
    }
    return maxCellCount;
}

inline float molecularProteinCompetition(
    device const ProteinRecord* proteins,
    uint base,
    uint proteinSlot,
    ProteinRecord focal
) {
    float competition = 0.0;
    float focalSignature = fract(
        float(focal.identity.y & 0xffffu) / 65535.0 + focal.physical.z * 0.37
    );
    for (uint other = 0u; other < proteinSlotsPerCell; ++other) {
        if (other == proteinSlot) { continue; }
        ProteinRecord competitor = proteins[base + other];
        if (competitor.abundance.x <= 0.000001) { continue; }
        float signature = fract(
            float(competitor.identity.y & 0xffffu) / 65535.0 +
                competitor.physical.z * 0.37
        );
        float distance = abs(signature - focalSignature);
        distance = min(distance, 1.0 - distance);
        competition += competitor.abundance.x * competitor.abundance.y *
            smoothstep(0.10, 0.0, distance) *
            (0.22 + competitor.coupling.x * 0.78);
    }
    return competition;
}

inline uint2 reactionSpeciesPair(GenomePage page) {
    uint encodedReactant = as_type<uint>(page.payload[12].x);
    uint encodedProduct = as_type<uint>(page.payload[12].y);
    if (encodedReactant > 0u && encodedProduct > 0u &&
        encodedReactant < speciesRegistryCapacity &&
        encodedProduct < speciesRegistryCapacity &&
        ((encodedReactant - 1u) >> 1u) == ((encodedProduct - 1u) >> 1u)) {
        return uint2(encodedReactant, encodedProduct);
    }
    uint pair = hash32(page.header.z ^ molecularSequenceHash(page)) %
        ((speciesRegistryCapacity - 1u) / 2u);
    uint lowerConformer = 1u + pair * 2u;
    return (page.header.z & 1u) == 0u
        ? uint2(lowerConformer + 1u, lowerConformer)
        : uint2(lowerConformer, lowerConformer + 1u);
}

inline uint transporterSpecies(GenomePage page, uint salt) {
    uint payloadLane = salt & 3u;
    uint encoded = as_type<uint>(page.payload[12][payloadLane]);
    if (encoded > 0u && encoded < speciesRegistryCapacity) { return encoded; }
    return 1u + hash32(page.header.z ^ molecularSequenceHash(page) ^ salt) %
        (speciesRegistryCapacity - 1u);
}

inline uint intracellularSlotForSpecies(
    thread uint4& species,
    thread float4& amount,
    uint speciesID
) {
    if (speciesID == 0u) { return 0u; }
    uint weakest = 1u;
    for (uint slot = 1u; slot < chemistryIntentWidth; ++slot) {
        if (amount[slot] > 0.0000001 && species[slot] == speciesID) { return slot; }
        if (amount[slot] <= 0.0000001) {
            species[slot] = speciesID;
            return slot;
        }
        if (amount[slot] < amount[weakest]) { weakest = slot; }
    }
    return weakest;
}

inline void addIntracellularMolecule(
    thread uint4& species,
    thread float4& amount,
    thread float4& freeEnergy,
    uint speciesID,
    float addedAmount,
    float addedFreeEnergy,
    thread float& overflowHeat
) {
    if (addedAmount <= 0.0 && addedFreeEnergy <= 0.0) { return; }
    uint slot = intracellularSlotForSpecies(species, amount, speciesID);
    if (slot > 0u && amount[slot] > 0.0000001 && species[slot] != speciesID) {
        amount[0] += amount[slot];
        overflowHeat += max(freeEnergy[slot], 0.0);
        amount[slot] = 0.0;
        freeEnergy[slot] = 0.0;
        species[slot] = speciesID;
    }
    amount[slot] += max(addedAmount, 0.0);
    freeEnergy[slot] += max(addedFreeEnergy, 0.0);
}

inline float removeIntracellularMolecule(
    thread uint4& species,
    thread float4& amount,
    thread float4& freeEnergy,
    uint speciesID,
    float requested,
    thread float& removedFreeEnergy
) {
    removedFreeEnergy = 0.0;
    if (requested <= 0.0) { return 0.0; }
    uint slot = speciesID == 0u ? 0u : chemistryIntentWidth;
    if (speciesID != 0u) {
        for (uint candidate = 1u; candidate < chemistryIntentWidth; ++candidate) {
            if (species[candidate] == speciesID && amount[candidate] > 0.0) {
                slot = candidate;
                break;
            }
        }
    }
    if (slot >= chemistryIntentWidth) { return 0.0; }
    float removed = min(max(amount[slot], 0.0), requested);
    float fraction = removed / max(amount[slot], 0.0000001);
    removedFreeEnergy = max(freeEnergy[slot], 0.0) * fraction;
    amount[slot] = max(amount[slot] - removed, 0.0);
    freeEnergy[slot] = max(freeEnergy[slot] - removedFreeEnergy, 0.0);
    if (slot > 0u && amount[slot] <= 0.0000001) {
        species[slot] = 0u;
        amount[slot] = 0.0;
        freeEnergy[slot] = 0.0;
    }
    return removed;
}

kernel void evolveMolecularExpression(
    device const CellState* cellsIn [[buffer(0)]],
    device CellState* cellsOut [[buffer(1)]],
    device const atomic_uint* cellOccupancy [[buffer(2)]],
    device const CellIdentity* identities [[buffer(3)]],
    device const GenomeHeader* genomeHeaders [[buffer(4)]],
    device const GenomePage* genomePages [[buffer(5)]],
    device float* regulatoryStates [[buffer(6)]],
    device const TranscriptRecord* transcriptsIn [[buffer(7)]],
    device TranscriptRecord* transcriptsOut [[buffer(8)]],
    device const ProteinRecord* proteinsIn [[buffer(9)]],
    device ProteinRecord* proteinsOut [[buffer(10)]],
    device const CellChemistrySettlement* settlements [[buffer(11)]],
    device const uint* cellParentIDs [[buffer(12)]],
    device const atomic_uint* ownerCellHeads [[buffer(13)]],
    device const uint* ownerCellNext [[buffer(14)]],
    constant SimulationUniforms& uniforms [[buffer(15)]],
    device const atomic_uint* activeCellCount [[buffer(16)]],
    device const uint* activeCellIndices [[buffer(17)]],
    device const SpeciesDefinition* speciesRegistry [[buffer(18)]],
    device const AgentState* agents [[buffer(19)]],
    texture2d_array<float, access::read> environmentState [[texture(0)]],
    uint compactIndex [[thread_position_in_grid]]
) {
    if (compactIndex >= atomic_load_explicit(activeCellCount, memory_order_relaxed)) {
        return;
    }
    uint cellIndex = activeCellIndices[compactIndex];
    if (cellIndex >= maxCellCount || atomic_load_explicit(
        &cellOccupancy[cellIndex], memory_order_relaxed
    ) != cellOccupancyAlive) { return; }
    CellIdentity identity = identities[cellIndex];
    if (identity.programIndex >= maxGenomeHeaderCount) { return; }
    CellState cell = cellsIn[cellIndex];
    initializeCellMaterialLedger(cell);
    cellsOut[cellIndex] = cell;
    uint4 intracellularSpecies = cell.intracellularSpecies;
    intracellularSpecies.x = 0u;
    float4 intracellularAmount = max(cell.intracellularAmount, float4(0.0));
    float4 intracellularFreeEnergy = max(
        cell.intracellularFreeEnergy, float4(0.0)
    );
    constexpr float transcriptMatterScale = 0.0000020;
    constexpr float proteinMatterScale = 0.0000080;
    uint owner = identity.owner;
    float4 localEnvironment = float4(0.0, 0.0, 0.5, 0.5);
    if (owner < maxAgentCount) {
        float2 worldPosition = clamp(
            cellWorldPosition(agents[owner], cell.position, uniforms),
            float2(0.0), float2(1.0)
        );
        uint2 environmentCoordinate = min(
            uint2(worldPosition * float2(uniforms.width, uniforms.height)),
            uint2(uniforms.width - 1u, uniforms.height - 1u)
        );
        localEnvironment = environmentState.read(environmentCoordinate, 0);
    }
    uint transcriptBase = cellIndex * transcriptSlotsPerCell;
    uint proteinBase = cellIndex * proteinSlotsPerCell;
    bool poolMatchesCell = transcriptsIn[transcriptBase].identity.w ==
        identity.persistentID;
    uint inheritedCell = maxCellCount;
    if (!poolMatchesCell) {
        inheritedCell = findMolecularParentIndex(
            identities, ownerCellHeads, ownerCellNext, identity.owner,
            cellParentIDs[cellIndex]
        );
    }
    uint inheritedTranscriptBase = inheritedCell < maxCellCount
        ? inheritedCell * transcriptSlotsPerCell : transcriptBase;
    uint inheritedProteinBase = inheritedCell < maxCellCount
        ? inheritedCell * proteinSlotsPerCell : proteinBase;

    float thermalStress = abs(saturate(localEnvironment.w) - 0.52);
    float hydrationStress = 1.0 - saturate(localEnvironment.z);
    float molecularStress = saturate(
        cell.signals.z * 0.42 + cell.lifeHistory.z * 0.48 +
        (1.0 - cell.physiology.w) * 0.52 + thermalStress * 0.22 +
        hydrationStress * 0.12
    );
    for (uint slot = 0u; slot < transcriptSlotsPerCell; ++slot) {
        TranscriptRecord transcript = poolMatchesCell
            ? transcriptsIn[transcriptBase + slot]
            : (inheritedCell < maxCellCount
                ? transcriptsIn[inheritedTranscriptBase + slot]
                : emptyTranscriptRecord(identity.persistentID));
        transcript.identity.w = identity.persistentID;
        float decay = clamp(
            transcript.kinetics.w + 0.0015 + molecularStress * 0.006,
            0.0015, 0.18
        );
        float priorTranscript = transcript.kinetics.x;
        transcript.kinetics.x *= exp(-decay * max(uniforms.dt, 0.25));
        intracellularAmount.x += max(
            priorTranscript - transcript.kinetics.x, 0.0
        ) * transcriptMatterScale;
        transcript.kinetics.z += uniforms.dt;
        transcript.kinetics.y = 0.0;
        transcriptsOut[transcriptBase + slot] = transcript;
    }
    for (uint slot = 0u; slot < proteinSlotsPerCell; ++slot) {
        ProteinRecord protein = poolMatchesCell
            ? proteinsIn[proteinBase + slot]
            : (inheritedCell < maxCellCount
                ? proteinsIn[inheritedProteinBase + slot]
                : emptyProteinRecord());
        float preferredTemperature = 0.12 +
            random01(protein.identity.y ^ 0x9e3779b9u) * 0.76;
        float temperatureMismatch = abs(
            saturate(localEnvironment.w) - preferredTemperature
        );
        float preferredElectrochemistry =
            signedRandom(protein.identity.y ^ 0x85ebca6bu) * 0.70;
        float electrochemicalMismatch = abs(
            clamp(cell.molecularEnergy.x - cell.molecularEnergy.y, -1.0, 1.0) -
            preferredElectrochemistry
        );
        float denaturation = (
            molecularStress * (1.08 - protein.physical.x) +
            temperatureMismatch * (0.36 + protein.physical.z * 0.52) +
            electrochemicalMismatch * abs(protein.physical.y) * 0.18
        ) * 0.0015;
        protein.abundance.z = saturate(
            protein.abundance.z + denaturation -
                cell.proteostasis.z * 0.004 - cell.proteostasis.w * 0.003
        );
        float turnover = 0.0008 + protein.abundance.z *
            (0.006 + cell.proteostasis.w * 0.012);
        float priorProtein = protein.abundance.x;
        protein.abundance.x *= exp(-turnover * max(uniforms.dt, 0.25));
        intracellularAmount.x += max(
            priorProtein - protein.abundance.x, 0.0
        ) * proteinMatterScale;
        protein.abundance.y = saturate(
            protein.abundance.y +
            (protein.physical.x * (1.0 - molecularStress) - protein.abundance.y) *
                (0.010 + cell.proteostasis.z * 0.022) - denaturation
        );
        protein.abundance.w += uniforms.dt;
        proteinsOut[proteinBase + slot] = protein;
    }

    float priorRegulator = max(cell.molecularExpression.z, 0.0);
    float sensors[24] = {
        cell.physiology.x * 2.0 - 1.0,
        cell.physiology.y * 2.0 - 1.0,
        cell.physiology.w * 2.0 - 1.0,
        cell.signals.x * 2.0 - 1.0,
        cell.signals.y * 2.0 - 1.0,
        cell.signals.z * 2.0 - 1.0,
        cell.signaling.x * 2.0 - 1.0,
        cell.signaling.y * 2.0 - 1.0,
        clamp(cell.dynamics.x, -1.0, 1.0),
        clamp(cell.mechanics.y, -1.0, 1.0),
        cell.tissueGeometry.z * 2.0 - 1.0,
        clamp(cell.tissueForce.w, -1.0, 1.0),
        cell.environment.x * 2.0 - 1.0,
        cell.environment.y * 2.0 - 1.0,
        cell.environment.z * 2.0 - 1.0,
        cell.environment.w * 2.0 - 1.0,
        cell.learning.x * 2.0 - 1.0,
        cell.learning.y * 2.0 - 1.0,
        cell.lifeHistory.x * 0.01 - 1.0,
        cell.lifeHistory.y * 0.02 - 1.0,
        molecularStress * 2.0 - 1.0,
        cell.molecularEnergy.x * 2.0 - 1.0,
        cell.molecularEnergy.y * 2.0 - 1.0,
        cell.molecularEnergy.z * 2.0 - 1.0
    };
    // Binding state alters promoter occupancy below. It does not become an
    // actuator: only translated, folded products update cellular capabilities.
    RegulatoryOutputs promoterBindingState = evolveDevelopmentalProgram(
        genomeHeaders, genomePages, regulatoryStates,
        identity.programIndex, cellIndex, sensors, 1u
    );
    (void)promoterBindingState;
    (void)priorRegulator;

    GenomeHeader header = genomeHeaders[identity.programIndex];
    float expressionEnergyAvailability = smoothstep(
        0.035, 0.24, cell.physiology.x
    );
    uint page = header.firstPage;
    uint traversed = 0u;
    float transcriptionWork = 0.0;
    while (page < genomePageCapacity && traversed < 512u) {
        GenomePage templatePage = genomePages[page];
        uint pageType = templatePage.header.x;
        uint regulationChannel = templatePage.header.z % regulatoryStateChannelCount;
        float activation = regulatoryStates[
            cellIndex * regulatoryStateChannelCount + regulationChannel
        ];
        float promoter = saturate(
            0.08 + activation * 0.72 +
            random01(templatePage.header.z ^ header.genomeHash) * 0.20
        );
        if (pageType == genomePageNoncoding) {
            promoter *= 0.06;
        }
        uint preferredSlot = hash32(templatePage.header.z ^ page) %
            transcriptSlotsPerCell;
        uint slot = preferredSlot;
        uint weakestSlot = preferredSlot;
        float weakestConcentration = 1000000.0;
        bool foundTranscriptSlot = false;
        for (uint probe = 0u; probe < transcriptSlotsPerCell; ++probe) {
            uint candidateSlot = (preferredSlot + probe) % transcriptSlotsPerCell;
            TranscriptRecord candidate = transcriptsOut[
                transcriptBase + candidateSlot
            ];
            if (candidate.identity.x == page &&
                candidate.identity.z == header.genomeHash) {
                slot = candidateSlot;
                foundTranscriptSlot = true;
                break;
            }
            if (candidate.identity.x >= genomePageCapacity ||
                candidate.kinetics.x <= 0.000001) {
                slot = candidateSlot;
                foundTranscriptSlot = true;
                break;
            }
            if (candidate.kinetics.x < weakestConcentration) {
                weakestConcentration = candidate.kinetics.x;
                weakestSlot = candidateSlot;
            }
        }
        if (!foundTranscriptSlot) { slot = weakestSlot; }
        TranscriptRecord transcript = transcriptsOut[transcriptBase + slot];
        bool sameTemplate = transcript.identity.x == page &&
            transcript.identity.z == header.genomeHash;
        if (sameTemplate || transcript.kinetics.x < promoter * 0.004) {
            if (!sameTemplate) {
                intracellularAmount.x += max(
                    transcript.kinetics.x, 0.0
                ) * transcriptMatterScale;
                transcript = emptyTranscriptRecord(identity.persistentID);
                transcript.identity = uint4(
                    page, templatePage.header.z, header.genomeHash,
                    identity.persistentID
                );
                transcript.kinetics.w = 0.006 +
                    random01(templatePage.header.z + 53u) * 0.034;
            }
            float requestedSynthesis = promoter *
                (0.0040 + cell.physiology.x * 0.0120) *
                max(uniforms.dt, 0.25) * expressionEnergyAvailability;
            float synthesis = min(
                requestedSynthesis,
                intracellularAmount.x / transcriptMatterScale
            );
            intracellularAmount.x = max(
                intracellularAmount.x - synthesis * transcriptMatterScale, 0.0
            );
            transcript.kinetics.x = min(transcript.kinetics.x + synthesis, 1.5);
            transcript.kinetics.y = synthesis;
            transcriptionWork += synthesis * 0.0008;
            transcriptsOut[transcriptBase + slot] = transcript;
        }
        page = templatePage.header.y;
        ++traversed;
    }

    float translationWork = 0.0;
    for (uint transcriptSlot = 0u; transcriptSlot < transcriptSlotsPerCell;
         ++transcriptSlot) {
        TranscriptRecord transcript = transcriptsOut[transcriptBase + transcriptSlot];
        uint templatePageIndex = transcript.identity.x;
        if (templatePageIndex >= genomePageCapacity || transcript.kinetics.x <= 0.000001) {
            continue;
        }
        GenomePage templatePage = genomePages[templatePageIndex];
        if (templatePage.header.z != transcript.identity.y) { continue; }
        uint preferredProteinSlot = hash32(
            templatePage.header.z ^ molecularSequenceHash(templatePage)
        ) % proteinSlotsPerCell;
        uint proteinSlot = preferredProteinSlot;
        uint weakestProteinSlot = preferredProteinSlot;
        float weakestProteinConcentration = 1000000.0;
        bool foundProteinSlot = false;
        for (uint probe = 0u; probe < proteinSlotsPerCell; ++probe) {
            uint candidateSlot = (preferredProteinSlot + probe) % proteinSlotsPerCell;
            ProteinRecord candidate = proteinsOut[proteinBase + candidateSlot];
            if (candidate.identity.x == templatePageIndex &&
                candidate.identity.y == templatePage.header.z) {
                proteinSlot = candidateSlot;
                foundProteinSlot = true;
                break;
            }
            if (candidate.identity.x >= genomePageCapacity ||
                candidate.abundance.x <= 0.000001) {
                proteinSlot = candidateSlot;
                foundProteinSlot = true;
                break;
            }
            if (candidate.abundance.x < weakestProteinConcentration) {
                weakestProteinConcentration = candidate.abundance.x;
                weakestProteinSlot = candidateSlot;
            }
        }
        if (!foundProteinSlot) { proteinSlot = weakestProteinSlot; }
        ProteinRecord protein = proteinsOut[proteinBase + proteinSlot];
        bool sameProduct = protein.identity.x == templatePageIndex &&
            protein.identity.y == templatePage.header.z;
        float requestedTranslation = transcript.kinetics.x *
            (0.0060 + cell.physiology.x * 0.0140) * max(uniforms.dt, 0.25) *
            expressionEnergyAvailability;
        float translation = min(requestedTranslation,
            intracellularAmount.x / proteinMatterScale);
        if (!sameProduct && protein.abundance.x > translation * 8.0) { continue; }
        if (!sameProduct) {
            intracellularAmount.x += max(
                protein.abundance.x, 0.0
            ) * proteinMatterScale;
            translation = min(requestedTranslation,
                intracellularAmount.x / proteinMatterScale);
            protein = proteinFromTemplate(
                templatePage, templatePageIndex, transcript.identity.z, 0.0
            );
        }
        intracellularAmount.x = max(
            intracellularAmount.x - translation * proteinMatterScale, 0.0
        );
        protein.abundance.x = min(protein.abundance.x + translation, 2.0);
        translationWork += translation * (0.0025 + protein.physical.z * 0.0010);
        proteinsOut[proteinBase + proteinSlot] = protein;
    }

    float4 molecularExpression = float4(0.0);
    float4 coupling = float4(0.0);
    float totalProtein = 0.0;
    float foldedProtein = 0.0;
    float damagedProtein = 0.0;
    float membraneProtein = 0.0;
    float foreignProtein = 0.0;
    float4 localization = float4(0.0);
    uint4 uptakeSpecies = uint4(0u);
    uint4 outputSpecies = uint4(0u);
    float4 routeStrength = float4(0.0);
    routeStrength.x = max(intracellularAmount.x, 0.000001);
    for (uint proteinSlot = 0u; proteinSlot < proteinSlotsPerCell; ++proteinSlot) {
        ProteinRecord protein = proteinsOut[proteinBase + proteinSlot];
        if (protein.abundance.x <= 0.000001) { continue; }
        float competition = molecularProteinCompetition(
            proteinsOut, proteinBase, proteinSlot, protein
        );
        float allostericSignal = regulatoryStates[
            cellIndex * regulatoryStateChannelCount +
                (protein.identity.y % regulatoryStateChannelCount)
        ];
        float effective = protein.abundance.x * protein.abundance.y *
            (0.42 + allostericSignal * 0.58) /
            (1.0 + competition + protein.abundance.z * 2.0);
        molecularExpression += protein.activity * effective;
        coupling += protein.coupling * effective;
        totalProtein += protein.abundance.x;
        foldedProtein += protein.abundance.x * protein.abundance.y;
        damagedProtein += protein.abundance.x * protein.abundance.z;
        membraneProtein += protein.abundance.x * protein.physical.w;
        foreignProtein += protein.abundance.x *
            (protein.identity.z != header.genomeHash ? 1.0 : 0.0);
        uint localizationIndex = min(protein.identity.w, 3u);
        localization[localizationIndex] += effective;
        uint templateIndex = protein.identity.x;
        if (templateIndex >= genomePageCapacity) { continue; }
        GenomePage expressedTemplate = genomePages[templateIndex];
        float routing = effective * (protein.activity.y + protein.coupling.x);
        uint route = 1u + protein.identity.y % 3u;
        if (routing > routeStrength[route]) {
            routeStrength[route] = routing;
            if (expressedTemplate.header.x == genomePageReaction) {
                uint2 pathway = reactionSpeciesPair(expressedTemplate);
                uptakeSpecies[route] = pathway.x;
                outputSpecies[route] = pathway.y;
            } else {
                uptakeSpecies[route] = transporterSpecies(
                    expressedTemplate, 0xa511e9b3u + route
                );
                outputSpecies[route] = transporterSpecies(
                    expressedTemplate, 0x63d83595u + route
                );
            }
        }
    }
    float inverseProtein = 1.0 / max(totalProtein, 0.000001);
    float foldedFraction = saturate(foldedProtein * inverseProtein);
    float damagedFraction = saturate(damagedProtein * inverseProtein);
    float localizationTotal = dot(localization, float4(1.0));
    float localizationDiversity = 0.0;
    if (localizationTotal > 0.000001) {
        float4 fractions = localization / localizationTotal;
        localizationDiversity = saturate(
            1.0 - dot(fractions, fractions)
        );
    }
    CellChemistrySettlement settlement = settlements[cellIndex];
    bool settlementIsCurrent = settlement.settledStep == uniforms.step;
    float overflowHeat = 0.0;
    float totalUptake = settlementIsCurrent
        ? dot(max(settlement.consumedAmount, float4(0.0)), float4(1.0)) : 0.0;
    for (uint route = 0u; route < chemistryIntentWidth; ++route) {
        float amount = settlementIsCurrent
            ? max(settlement.consumedAmount[route], 0.0) : 0.0;
        float energy = totalUptake > 0.0
            ? max(settlement.capturedFreeEnergy, 0.0) * amount / totalUptake : 0.0;
        addIntracellularMolecule(
            intracellularSpecies, intracellularAmount, intracellularFreeEnergy,
            cell.molecularUptakeSpecies[route], amount, energy, overflowHeat
        );
        uint uptakeSpeciesID = cell.molecularUptakeSpecies[route];
        if (amount > 0.0 && uptakeSpeciesID < speciesRegistryCapacity) {
            applySpeciesCompositionToLedger(
                cell, speciesRegistry[uptakeSpeciesID], amount
            );
        }
        float removedEnergy = 0.0;
        float secreted = settlementIsCurrent
            ? max(settlement.secretedAmount[route], 0.0) : 0.0;
        float removed = removeIntracellularMolecule(
            intracellularSpecies, intracellularAmount, intracellularFreeEnergy,
            cell.molecularOutputSpecies[route],
            secreted,
            removedEnergy
        );
        uint outputSpeciesID = cell.molecularOutputSpecies[route];
        if (removed > 0.0 && outputSpeciesID < speciesRegistryCapacity) {
            applySpeciesCompositionToLedger(
                cell, speciesRegistry[outputSpeciesID], -removed
            );
        }
    }

    float forwardFlux = 0.0;
    float reverseFlux = 0.0;
    float capturedReactionWork = 0.0;
    float reactionHeat = overflowHeat;
    float uphillReactionWork = 0.0;
    float priorInternalBarrier = saturate(cell.internalMembrane.x * 12.0) *
        saturate(cell.internalMembrane.w);
    page = header.firstPage;
    traversed = 0u;
    while (page < genomePageCapacity && traversed < 512u) {
        GenomePage reactionPage = genomePages[page];
        if (reactionPage.header.x == genomePageReaction) {
            float catalyst = 0.0;
            float localizedCatalyst = 0.0;
            for (uint proteinSlot = 0u; proteinSlot < proteinSlotsPerCell;
                 ++proteinSlot) {
                ProteinRecord protein = proteinsOut[proteinBase + proteinSlot];
                if (protein.identity.x != page || protein.abundance.x <= 0.0) { continue; }
                float competition = molecularProteinCompetition(
                    proteinsOut, proteinBase, proteinSlot, protein
                );
                float activator = regulatoryStates[
                    cellIndex * regulatoryStateChannelCount +
                        (protein.identity.y % regulatoryStateChannelCount)
                ];
                float catalyticContribution =
                    protein.abundance.x * protein.abundance.y * protein.activity.x *
                    (0.18 + activator * 0.82) /
                    (1.0 + competition + protein.abundance.z * 2.0);
                catalyst += catalyticContribution;
                localizedCatalyst += catalyticContribution * protein.physical.w;
            }
            if (catalyst > 0.0000001) {
                uint2 pathway = reactionSpeciesPair(reactionPage);
                uint reactantSlot = chemistryIntentWidth;
                uint productSlot = chemistryIntentWidth;
                for (uint slot = 1u; slot < chemistryIntentWidth; ++slot) {
                    if (intracellularSpecies[slot] == pathway.x) { reactantSlot = slot; }
                    if (intracellularSpecies[slot] == pathway.y) { productSlot = slot; }
                }
                float reactantAmount = reactantSlot < chemistryIntentWidth
                    ? intracellularAmount[reactantSlot] : 0.0;
                float productAmount = productSlot < chemistryIntentWidth
                    ? intracellularAmount[productSlot] : 0.0;
                float forwardBarrier = 0.14 +
                    abs(reactionPage.payload[4].z) * 0.72;
                float reverseBarrier = 0.14 +
                    abs(reactionPage.payload[4].w) * 0.72;
                float chemicalDrive = 0.18 + cell.molecularEnergy.z * 0.82;
                float localizedFraction = saturate(
                    localizedCatalyst / max(catalyst, 0.0000001)
                );
                uint sourceMask = reactantSlot < chemistryIntentWidth
                    ? (1u << reactantSlot) : 1u;
                uint productMask = productSlot < chemistryIntentWidth
                    ? (1u << productSlot) : 1u;
                float causalDomainBarrier = cellDomainBarrierForSpeciesMask(
                    cell, sourceMask | productMask
                );
                float compartmentConcentration = 1.0 + max(
                    priorInternalBarrier, causalDomainBarrier
                ) * saturate(cell.internalMembrane.z) * localizedFraction *
                    (0.18 + (1.0 - saturate(cell.internalMembrane.y)) * 0.42);
                float forwardRate = reactantAmount * catalyst *
                    exp(-forwardBarrier / max(chemicalDrive, 0.04)) *
                    compartmentConcentration;
                float reverseRate = productAmount * catalyst *
                    exp(-reverseBarrier / max(chemicalDrive, 0.04)) *
                    compartmentConcentration;
                float forward = min(
                    reactantAmount,
                    forwardRate * max(uniforms.dt, 0.25) * 0.18
                );
                float reverse = min(
                    productAmount,
                    reverseRate * max(uniforms.dt, 0.25) * 0.18
                );
                float net = forward - reverse;
                uint sourceSpecies = net >= 0.0 ? pathway.x : pathway.y;
                uint destinationSpecies = net >= 0.0 ? pathway.y : pathway.x;
                float requested = abs(net);
                SpeciesDefinition sourceDefinition = speciesRegistry[sourceSpecies];
                SpeciesDefinition destinationDefinition = speciesRegistry[destinationSpecies];
                float uphillPerAmount = max(
                    destinationDefinition.physical.x - sourceDefinition.physical.x, 0.0
                );
                if (uphillPerAmount > 0.0) {
                    requested = min(
                        requested,
                        max(cell.physiology.x, 0.0) * 0.00012 / uphillPerAmount
                    );
                }
                float removedEnergy = 0.0;
                float reacted = removeIntracellularMolecule(
                    intracellularSpecies, intracellularAmount, intracellularFreeEnergy,
                    sourceSpecies, requested, removedEnergy
                );
                if (net >= 0.0) {
                    forwardFlux += reacted;
                } else {
                    reverseFlux += reacted;
                }
                float productEnergy = reacted * destinationDefinition.physical.x;
                float energyDifference = removedEnergy - productEnergy;
                float usableFraction = clamp(
                    0.18 + abs(reactionPage.payload[4].y) * 0.62,
                    0.08, 0.88
                );
                if (energyDifference >= 0.0) {
                    capturedReactionWork += energyDifference * usableFraction;
                    reactionHeat += energyDifference * (1.0 - usableFraction);
                } else {
                    uphillReactionWork += -energyDifference;
                }
                addIntracellularMolecule(
                    intracellularSpecies, intracellularAmount, intracellularFreeEnergy,
                    destinationSpecies, reacted, productEnergy, reactionHeat
                );
            }
        }
        page = reactionPage.header.y;
        ++traversed;
    }

    float membraneLocalization = membraneProtein * inverseProtein;
    float internalMembraneBuildRequest = molecularExpression.w * foldedFraction *
        (0.20 + membraneLocalization * 0.80) *
        (0.15 + localizationDiversity * 0.85) *
        max(uniforms.dt, 0.25) * 0.00018;
    internalMembraneBuildRequest = min(
        internalMembraneBuildRequest,
        max(intracellularAmount.x - 0.00040, 0.0)
    );
    float removedMembraneEnergy = 0.0;
    float internalMembraneBuild = removeIntracellularMolecule(
        intracellularSpecies, intracellularAmount, intracellularFreeEnergy,
        0u, internalMembraneBuildRequest, removedMembraneEnergy
    );
    uint activeDomains = activeCellDomainCount(cell);
    uint buildDomain = 0u;
    float weakestDomainMass = INFINITY;
    for (uint domain = 0u; domain < internalDomainCount; ++domain) {
        uint4 identity = cellDomainIdentity(cell, domain);
        float mass = cellDomainGeometry(cell, domain).w;
        if (identity.x == 0u) {
            buildDomain = domain;
            weakestDomainMass = -1.0;
            break;
        }
        if (mass < weakestDomainMass) {
            weakestDomainMass = mass;
            buildDomain = domain;
        }
    }
    bool canNucleateDomain = activeDomains < internalDomainCount &&
        internalMembraneBuild > 0.0000005 && localizationDiversity > 0.02;
    if (canNucleateDomain) {
        float angle = random01(
            hash32(cellIndex ^ uniforms.step ^ buildDomain * 0x9e3779b9u)
        ) * 2.0 * M_PI_F;
        uint speciesMask = 1u << ((buildDomain + identity.persistentID) % 4u);
        setCellDomain(
            cell, buildDomain,
            float4(float2(cos(angle), sin(angle)) * 0.22, 0.12,
                internalMembraneBuild),
            float4(
                saturate(molecularExpression.y), localizationDiversity,
                saturate(0.34 + internalMembraneBuild * 80.0),
                clamp(cell.molecularEnergy.x - cell.molecularEnergy.y, -1.0, 1.0)
            ),
            float4(0.0, 0.0, 0.0, 0.0),
            uint4(1u, speciesMask, 1u, 0xffffffffu)
        );
    } else if (activeDomains > 0u && internalMembraneBuild > 0.0) {
        float4 geometry = cellDomainGeometry(cell, buildDomain);
        geometry.w += internalMembraneBuild;
        geometry.z = clamp(sqrt(geometry.w * 2.4), 0.08, 0.56);
        setCellDomain(
            cell, buildDomain, geometry, cellDomainTransport(cell, buildDomain),
            cellDomainChemistry(cell, buildDomain), cellDomainIdentity(cell, buildDomain)
        );
    }

    float internalMembraneMass = 0.0;
    float permeabilityWeighted = 0.0;
    float selectivityWeighted = 0.0;
    float integrityWeighted = 0.0;
    for (uint domain = 0u; domain < internalDomainCount; ++domain) {
        uint4 domainIdentity = cellDomainIdentity(cell, domain);
        if (domainIdentity.x == 0u) { continue; }
        float4 geometry = cellDomainGeometry(cell, domain);
        float4 transport = cellDomainTransport(cell, domain);
        float4 chemistry = cellDomainChemistry(cell, domain);
        float erosion = geometry.w * (
            0.0006 + molecularStress * 0.0008 + damagedFraction * 0.0012
        );
        geometry.w = max(geometry.w - erosion, 0.0);
        geometry.z = clamp(sqrt(geometry.w * 2.4), 0.0, 0.56);
        transport.x = saturate(
            transport.x * 0.996 + molecularExpression.y * 0.004
        );
        transport.y = saturate(
            transport.y * 0.997 + localizationDiversity * molecularExpression.z * 0.003
        );
        transport.z = saturate(
            transport.z * 0.998 + internalMembraneBuild * 48.0 +
                coupling.y * 0.0012 - damagedFraction * geometry.w * 0.020
        );
        transport.w = clamp(
            transport.w * 0.996 +
                (cell.molecularEnergy.x - cell.molecularEnergy.y) * 0.004,
            -1.0, 1.0
        );
        chemistry.x = 0.0;
        chemistry.y = 0.0;
        for (uint slot = 0u; slot < chemistryIntentWidth; ++slot) {
            if ((domainIdentity.y & (1u << slot)) == 0u) { continue; }
            chemistry.x += intracellularAmount[slot];
            chemistry.y += intracellularFreeEnergy[slot];
        }
        chemistry.z = (forwardFlux + reverseFlux) * transport.z;
        chemistry.w = chemistry.x * transport.x * (1.0 - transport.z) * 0.001;
        if (geometry.w <= 0.0000001 || transport.z <= 0.001) {
            setCellDomain(
                cell, domain, float4(0.0), float4(0.0), float4(0.0), uint4(0u)
            );
            continue;
        }
        setCellDomain(cell, domain, geometry, transport, chemistry, domainIdentity);
        internalMembraneMass += geometry.w;
        permeabilityWeighted += transport.x * geometry.w;
        selectivityWeighted += transport.y * geometry.w;
        integrityWeighted += transport.z * geometry.w;
    }
    float inverseDomainMass = 1.0 / max(internalMembraneMass, 0.000001);
    float internalPermeability = saturate(permeabilityWeighted * inverseDomainMass);
    float internalSelectivity = saturate(selectivityWeighted * inverseDomainMass);
    float internalIntegrity = saturate(integrityWeighted * inverseDomainMass);
    cell.internalMembrane = float4(
        internalMembraneMass, internalPermeability, internalSelectivity, internalIntegrity
    );

    float symbiontAbundance = max(cell.symbiontState.x, 0.0);
    float symbiontReplication = saturate(cell.symbiontState.y);
    float symbiontIntegration = saturate(cell.symbiontState.z);
    float symbiontDependence = saturate(cell.symbiontState.w);
    float symbiontEnergyExport = 0.0;
    float symbiontRedoxExport = 0.0;
    float symbiontSubstrate = 0.0;
    float symbiontConflict = 0.0;
    if (symbiontAbundance > 0.000001 &&
        cell.symbiontIdentity.x < genomePageCapacity) {
        // The captured propagule retains an immutable foreign page chain. It
        // can export energy only by executing one of its own balanced reaction
        // templates against molecules physically present inside the enclosure.
        uint symbiontPage = cell.symbiontIdentity.x;
        uint symbiontPagesTraversed = 0u;
        while (symbiontPage < genomePageCapacity &&
               symbiontPagesTraversed < 128u) {
            GenomePage symbiontTemplate = genomePages[symbiontPage];
            if (symbiontTemplate.header.x == genomePageReaction) {
                uint2 pathway = reactionSpeciesPair(symbiontTemplate);
                uint reactantSlot = chemistryIntentWidth;
                uint productSlot = chemistryIntentWidth;
                for (uint slot = 1u; slot < chemistryIntentWidth; ++slot) {
                    if (intracellularSpecies[slot] == pathway.x) {
                        reactantSlot = slot;
                    }
                    if (intracellularSpecies[slot] == pathway.y) {
                        productSlot = slot;
                    }
                }
                float reactantAmount = reactantSlot < chemistryIntentWidth
                    ? intracellularAmount[reactantSlot] : 0.0;
                float productAmount = productSlot < chemistryIntentWidth
                    ? intracellularAmount[productSlot] : 0.0;
                float catalyst = symbiontAbundance *
                    (0.12 + symbiontReplication * 0.58 +
                        symbiontIntegration * 0.30);
                float forwardBarrier = 0.14 +
                    abs(symbiontTemplate.payload[4].z) * 0.72;
                float reverseBarrier = 0.14 +
                    abs(symbiontTemplate.payload[4].w) * 0.72;
                float forward = reactantAmount * catalyst * exp(-forwardBarrier) *
                    max(uniforms.dt, 0.25) * 0.12;
                float reverse = productAmount * catalyst * exp(-reverseBarrier) *
                    max(uniforms.dt, 0.25) * 0.12;
                float net = forward - reverse;
                uint sourceSpecies = net >= 0.0 ? pathway.x : pathway.y;
                uint destinationSpecies = net >= 0.0 ? pathway.y : pathway.x;
                SpeciesDefinition sourceDefinition = speciesRegistry[sourceSpecies];
                SpeciesDefinition destinationDefinition =
                    speciesRegistry[destinationSpecies];
                float freeEnergyDrop =
                    sourceDefinition.physical.x - destinationDefinition.physical.x;
                if (abs(net) > 0.0000001 && freeEnergyDrop >= 0.0) {
                    float removedEnergy = 0.0;
                    float reacted = removeIntracellularMolecule(
                        intracellularSpecies, intracellularAmount,
                        intracellularFreeEnergy, sourceSpecies, abs(net),
                        removedEnergy
                    );
                    float productEnergy =
                        reacted * destinationDefinition.physical.x;
                    float releasedEnergy = max(
                        removedEnergy - productEnergy, 0.0
                    );
                    float exchangeEfficiency = clamp(
                        0.12 + symbiontIntegration * 0.58 -
                            symbiontConflict * 0.18,
                        0.04, 0.72
                    );
                    float redoxFraction = clamp(
                        0.08 + symbiontIntegration * 0.14, 0.08, 0.22
                    );
                    symbiontEnergyExport +=
                        releasedEnergy * exchangeEfficiency;
                    symbiontRedoxExport += releasedEnergy * redoxFraction;
                    reactionHeat += releasedEnergy * max(
                        1.0 - exchangeEfficiency - redoxFraction, 0.0
                    );
                    symbiontSubstrate += reacted;
                    addIntracellularMolecule(
                        intracellularSpecies, intracellularAmount,
                        intracellularFreeEnergy, destinationSpecies, reacted,
                        productEnergy, reactionHeat
                    );
                }
            }
            symbiontPage = symbiontTemplate.header.y;
            ++symbiontPagesTraversed;
        }
        symbiontReplication = saturate(
            symbiontReplication * 0.998 + symbiontSubstrate * 5.0 +
                symbiontEnergyExport * 1.8
        );
        symbiontAbundance = max(
            symbiontAbundance * (0.9996 - molecularStress * 0.0006) +
                symbiontSubstrate * symbiontReplication * 0.12,
            0.0
        );
        symbiontIntegration = saturate(
            symbiontIntegration * 0.999 +
                internalMembraneMass * internalIntegrity * 0.0012
        );
        symbiontDependence = saturate(
            symbiontDependence * 0.9998 +
                max(symbiontEnergyExport - capturedReactionWork, 0.0) * 0.18 -
                max(capturedReactionWork - symbiontEnergyExport, 0.0) * 0.04
        );
        symbiontConflict = saturate(
            (1.0 - symbiontIntegration) * symbiontAbundance * 0.14 +
                molecularStress * symbiontAbundance * 0.08
        );
    } else if (symbiontAbundance > 0.000001) {
        symbiontAbundance *= 0.998;
        symbiontReplication *= 0.996;
    }
    cell.symbiontState = float4(
        symbiontAbundance, symbiontReplication,
        symbiontIntegration, symbiontDependence
    );
    cell.symbiontExchange = float4(
        symbiontEnergyExport, symbiontRedoxExport,
        symbiontSubstrate, symbiontConflict
    );
    cell.intracellularSpecies = intracellularSpecies;
    cell.intracellularAmount = intracellularAmount;
    cell.intracellularFreeEnergy = intracellularFreeEnergy;
    cell.reactionFlux = float4(
        forwardFlux, reverseFlux, capturedReactionWork,
        reactionHeat
    );

    float capturedEnergy = capturedReactionWork + symbiontEnergyExport;
    float organizedInternalBarrier = saturate(internalMembraneMass * 12.0) *
        internalIntegrity;
    float pumpActivity = coupling.w *
        saturate(molecularExpression.y + cell.physiology.x * 0.35) *
        (1.0 + organizedInternalBarrier * internalSelectivity * 0.32);
    float compartmentLeak = mix(
        1.0,
        clamp(internalPermeability * (1.0 - internalSelectivity * 0.54), 0.08, 1.0),
        organizedInternalBarrier
    );
    float channelLeak = molecularExpression.y *
        (0.00035 + membraneProtein * inverseProtein * 0.00065) *
        (1.0 - saturate(coupling.w) * 0.48) * compartmentLeak;
    float protonGradient = clamp(
        cell.molecularEnergy.x * 0.997 + pumpActivity * 0.0032 +
        capturedEnergy * molecularExpression.x * 0.014 - channelLeak,
        0.0, 1.5
    );
    float ionGradient = clamp(
        cell.molecularEnergy.y * 0.998 + pumpActivity * 0.0024 -
        channelLeak * 0.72,
        0.0, 1.5
    );
    float redox = clamp(
        cell.molecularEnergy.z * 0.996 + capturedEnergy *
            molecularExpression.x * 0.018 - pumpActivity * 0.0018,
        0.0, 1.5
    );
    float expressionWork = transcriptionWork + translationWork +
        pumpActivity * 0.000028 + damagedFraction * coupling.y * 0.000016;
    expressionWork += uphillReactionWork + internalMembraneBuild * 0.012;
    cell.molecularEnergy = float4(
        protonGradient, ionGradient, redox, expressionWork
    );
    cell.molecularExpression = saturate(molecularExpression);
    cell.proteostasis = float4(
        foldedFraction, damagedFraction,
        saturate(coupling.y), saturate(coupling.z)
    );
    float chemicalResponseRate = 0.006 +
        saturate(molecularExpression.z) * foldedFraction * 0.032;
    float4 chemicallyProducedRegulationA = saturate(float4(
        molecularExpression.z * molecularExpression.x,
        molecularExpression.z * molecularExpression.w,
        molecularExpression.z * coupling.w,
        molecularExpression.z * (coupling.y + coupling.z) * 0.5
    ) * foldedFraction);
    float4 chemicallyProducedRegulationB = saturate(float4(
        molecularExpression.y * molecularExpression.z,
        molecularExpression.x * molecularExpression.y,
        molecularExpression.z * (coupling.y + coupling.z) * 0.5,
        molecularExpression.y * coupling.w
    ) * foldedFraction);
    cell.regulation = mix(
        cell.regulation, chemicallyProducedRegulationA, chemicalResponseRate
    );
    cell.regulationB = mix(
        cell.regulationB, chemicallyProducedRegulationB, chemicalResponseRate
    );
    float inheritedForeign = foreignProtein * inverseProtein;
    cell.compartments = float4(
        saturate(localizationDiversity * internalIntegrity),
        saturate(internalMembraneMass * 12.0 + membraneProtein * inverseProtein * 0.24),
        saturate(max(inheritedForeign, symbiontAbundance)),
        clamp(
            cell.compartments.w * 0.999 +
                localizationDiversity * foldedFraction * internalIntegrity * 0.0015 +
                symbiontIntegration * symbiontAbundance * 0.0025 -
                damagedFraction * 0.0018,
            0.0, 1.0
        )
    );
    cell.molecularUptakeSpecies = uptakeSpecies;
    cell.molecularOutputSpecies = outputSpecies;
    cellsOut[cellIndex] = cell;
}
